{
  "routes": [
    {
      "route": "/product/*",
      "rewrite": "/product/__shell__/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_next/*",
      "/images/*",
      "/icons/*",
      "*.{css,js,json,svg,png,jpg,jpeg,webp,avif,ico,woff,woff2,ttf,webmanifest,xml,txt,mp4}"
    ]
  },
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Referrer-Policy": "same-origin",
    "X-Content-Type-Options": "nosniff",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
