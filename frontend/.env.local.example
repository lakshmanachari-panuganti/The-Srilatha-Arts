NEXT_PUBLIC_API_BASE_URL=http://localhost:7071/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay: the PUBLIC key id is returned by /api/razorpay/create-order at
# runtime, so the frontend doesn't need an env var. The secret lives only
# on the Function App app settings (and, eventually, Key Vault references).
